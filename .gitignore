# ---------------------------------------------------------------------------
# Gradle
# ---------------------------------------------------------------------------
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties
gradle-app.setting
.gradletasknamecache

# ---------------------------------------------------------------------------
# Kotlin / Kotlin Native
# ---------------------------------------------------------------------------
.kotlin/
*.hprof
*.kexe
*.klib
*.framework
*.xcframework

# ---------------------------------------------------------------------------
# IntelliJ / Android Studio
# ---------------------------------------------------------------------------
.idea/
*.iml
*.iws
*.ipr
out/
.idea_modules/
.navigation/
captures/

# ---------------------------------------------------------------------------
# Android
# ---------------------------------------------------------------------------
local.properties
!local.properties.example
*.apk
*.aab
*.ap_
*.dex
*.class
bin/
gen/
release/
.externalNativeBuild/
.cxx/

# ---------------------------------------------------------------------------
# Xcode / iOS
# ---------------------------------------------------------------------------
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
DerivedData/
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
*.xcworkspace
!default.xcworkspace
Pods/
!Podfile.lock
!Podfile
.build/
.swiftpm/
Packages/
Package.resolved
iosApp/iosApp/Info.plist.bak

# Fastlane
fastlane/report.xml
fastlane/screenshots
fastlane/test_output
fastlane/Preview.html
fastlane/scanfile
fastlane/Deliverfile

# ---------------------------------------------------------------------------
